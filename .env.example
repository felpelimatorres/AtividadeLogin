# =====================================================================
#  Copie este arquivo para ".env" (na raiz do projeto) e preencha.
#  O .env está no .gitignore: suas credenciais nunca vão para o GitHub.
# =====================================================================

# String de conexão do MongoDB Atlas (Atlas > Database > Connect > Drivers > Java).
# O esquema mongodb+srv já usa TLS. Troque <usuario>, <senha> e <cluster>.
# Se a senha tiver caracteres especiais (@ : / ? # [ ]), use URL encoding (ex.: @ -> %40).
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=login-seguro

# Banco de dados usado pela aplicação (criado automaticamente no primeiro uso)
MONGODB_DATABASE=login_seguro

# Primeiro administrador (criado só se ainda não houver nenhum ADMIN).
# A senha precisa seguir a política: 8+ caracteres, maiúscula, minúscula, número e símbolo.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=TroqueEstaSenha@2026

# Tema padrão para visitantes e usuários sem preferência (padrao | escuro)
APP_DEFAULT_THEME=padrao

# true em produção com HTTPS (cookie de sessão só trafega criptografado)
COOKIE_SECURE=false

# Porta HTTP local
PORT=8080
